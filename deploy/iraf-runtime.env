IRAF_PROFILE=/path/to/robot-profile.yaml
IRAF_SAFETY_POLICY=/path/to/safety-policy.yaml
IRAF_SKILL_ROOT=/path/to/skills
IRAF_BACKEND_ENTRYPOINT=backend_module:BackendClass
IRAF_BACKEND_CONFIG="{\"model_path\":\"/path/to/model.xml\"}"
IRAF_EVENT_STORE=/path/to/build/iraf-runtime.db
IRAF_HTTP_DEVELOPMENT=true
IRAF_RUNTIME_HOST=127.0.0.1
IRAF_RUNTIME_PORT=8765
IRAF_RUNTIME_TOKEN=replace-at-deploy-time
IRAF_RUNTIME_SUBJECT=agentos-development
IRAF_GRPC_DEVELOPMENT=true
IRAF_GRPC_HOST=127.0.0.1
IRAF_GRPC_PORT=50051
IRAF_GRPC_TOKEN=replace-at-deploy-time
IRAF_AGENTOS_MODEL_URL=https://agentos-model.example/v1
IRAF_AGENTOS_MODEL=model-id
IRAF_AGENTOS_TOKEN=replace-at-deploy-time
IRAF_AGENTOS_VERIFY_TLS=true
IRAF_AGENTOS_TIMEOUT_SECONDS=10
