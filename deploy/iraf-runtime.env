# Copy to /etc/iraf-runtime.env and replace every placeholder before deployment.
IRAF_PROFILE=/home/coretek/AIIRAF/profiles/piper_mujoco.yaml
IRAF_SAFETY_POLICY=/home/coretek/AIIRAF/profiles/safety/simulation_lab.yaml
IRAF_SKILL_ROOT=/home/coretek/AIIRAF/skills
IRAF_BACKEND_ENTRYPOINT=iraf_adapters.mujoco.mujoco_backend:MujocoBackend
# IRAF_BACKEND_CONFIG 不手写：它随场景报告演进（夹爪几何字段、vision 段都会变），
# 手写副本会静默过期（实测已发生两次：缺 wrist_body/*_finger_geom → 装配失败；
# 缺 vision 段 → visual_pick 报"未提供视觉证据路径"）。生成方式：
#   PYTHONPATH=src python3 scripts/emit_backend_config.py \
#       --scene build/models/piper-pick-scene.xml --compact
IRAF_BACKEND_CONFIG="{\"model_path\":\"/path/to/generated/piper-pick-scene.xml\",\"realtime\":false,\"manipulation\":{\"targets\":{\"box_01\":{\"body\":\"box_01\",\"pose_tolerance_m\":0.005}},\"gripper\":{\"wrist_body\":\"link6\",\"left_finger_body\":\"link7\",\"right_finger_body\":\"link8\",\"left_finger_geom\":\"piper_left_finger\",\"right_finger_geom\":\"piper_right_finger\",\"open_positions\":{\"joint7\":0.035,\"joint8\":-0.035},\"closed_positions\":{\"joint7\":0.023,\"joint8\":-0.023},\"lift_positions\":{\"joint1\":8.817883881308324e-06,\"joint2\":0.7632632740922249,\"joint3\":-0.07739575802742535,\"joint4\":6.886127597847464e-07,\"joint5\":-0.11474807960480611,\"joint6\":1.086222916722074e-09,\"joint7\":0.023,\"joint8\":-0.023},\"min_lift_delta_m\":0.02,\"min_normal_force_n\":0.2,\"max_force_imbalance_ratio\":4.0,\"pad_offset_m\":0.029835769,\"pad_offset_axis\":[0.0,0.0,1.0],\"home_positions\":{\"joint1\":0.0,\"joint2\":0.0,\"joint3\":0.0,\"joint4\":0.0,\"joint5\":0.0,\"joint6\":0.0,\"joint7\":0.035,\"joint8\":-0.035},\"approach_positions\":{\"joint1\":9.470225057716738e-06,\"joint2\":0.9866415883704546,\"joint3\":-0.0857225462089403,\"joint4\":5.191999044638938e-07,\"joint5\":-0.11259747510912314,\"joint6\":1.0643648979311e-09,\"joint7\":0.035,\"joint8\":-0.035},\"grasp_positions\":{\"joint1\":1.0124345867849368e-05,\"joint2\":1.2590016451859027,\"joint3\":-0.12395768289358791,\"joint4\":3.296684781927198e-07,\"joint5\":-0.12045255510754514,\"joint6\":1.1375993140103378e-09,\"joint7\":0.035,\"joint8\":-0.035}}},\"vision\":{\"evidence_file\":\"build/calibration/piper-vision-target.json\",\"refresh\":\"always\",\"detector\":{\"command\":[\"{python}\",\"scripts/detect_piper_targets.py\",\"--model\",\"{model}\",\"--config\",\"{config}\",\"--output\",\"{evidence}\"],\"config_file\":\"config/piper_multi_target.yaml\"}}}"
IRAF_EVENT_STORE=/home/coretek/AIIRAF/build/iraf-runtime.db
IRAF_HTTP_DEVELOPMENT=true
IRAF_RUNTIME_HOST=127.0.0.1
IRAF_RUNTIME_PORT=8765
IRAF_RUNTIME_TOKEN=replace-at-deploy-time
IRAF_RUNTIME_SUBJECT=agentos-development
IRAF_GRPC_DEVELOPMENT=true
IRAF_GRPC_HOST=127.0.0.1
IRAF_GRPC_PORT=50051
IRAF_GRPC_TOKEN=replace-at-deploy-time
IRAF_AGENTOS_MODEL_URL=https://agentos-model.example/v1
IRAF_AGENTOS_MODEL=model-id
IRAF_AGENTOS_TOKEN=replace-at-deploy-time
IRAF_AGENTOS_VERIFY_TLS=true
IRAF_AGENTOS_TIMEOUT_SECONDS=10
