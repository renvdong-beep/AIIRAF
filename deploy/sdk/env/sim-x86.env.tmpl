# IRAF 运行装配单（x86 仿真侧 Capability Provider）—— 由 install-iraf.sh 按声明渲染，勿手改。
#
# 口径（AGENTS.md 1.7）：本档一切能力都是**仿真**；Health 恒为 simulation=true，
# 任何结论都不构成真机/实时能力证据。
#
# 占位符来源（机器相关的值不许写死在仓库里，铁律 5.3）：
#   @PROFILE@ / @SAFETY_POLICY@  ← sim-x86 角色声明的 robot_profile / safety_policy
#   @VERSION_DIR@ / @DATA_DIR@   ← 声明生效值（current 链接 / 数据目录）
#   @BACKEND_CONFIG@             ← 安装期由场景报告生成（scripts/emit_backend_config.py，禁止手写）
#   @PROVIDER_DISPLAY_MODE@      ← 角色声明 provider_display（window | headless）
#   @PROVIDER_DISPLAY@ / @PROVIDER_XAUTHORITY@ ← 部署期 --env-set（window 模式必填）

# —— 装配六项（与 src/iraf_adapters/bootstrap.py 同源；缺项即显式失败）——
IRAF_PROFILE=@PROFILE@
IRAF_SAFETY_POLICY=@SAFETY_POLICY@
IRAF_SKILL_ROOT=@VERSION_DIR@/skills
IRAF_BACKEND_ENTRYPOINT=iraf_adapters.mujoco.mujoco_backend:MujocoBackend
IRAF_BACKEND_CONFIG=@BACKEND_CONFIG@
IRAF_EVENT_STORE=@DATA_DIR@/iraf-provider.db

# —— 跨机服务端 ——
# 端口来自声明 services[].ports（@PROVIDER_PORT@ 由安装器注入，不在这里再写一遍）；
# 绑定地址是机器相关值，只能由部署期给：--env-set PROVIDER_BIND=<监听地址>
IRAF_PROVIDER_HOST=@PROVIDER_BIND@
IRAF_PROVIDER_PORT=@PROVIDER_PORT@
IRAF_RUNTIME_SUBJECT=@RUNTIME_SUBJECT@

# —— 显示（先看得见优先；headless 时进程强制不开窗并如实记 detail）——
IRAF_PROVIDER_DISPLAY_MODE=@PROVIDER_DISPLAY_MODE@
DISPLAY=@PROVIDER_DISPLAY@
XAUTHORITY=@PROVIDER_XAUTHORITY@
MUJOCO_GL=glfw
LIBGL_ALWAYS_SOFTWARE=1

# —— 凭据 ——
# IRAF_PROVIDER_TOKEN 不写在这里：由 --secrets-file 落到 <config_dir>/runtime.secrets（600），
# 单元用 EnvironmentFile 引入。缺 token ⇒ 进程 fail-closed 退出（不监听端口）。
