# IRAF 边缘智能域（edge-intel）运行装配单 —— 模板（2026-10-16）
#
# 用法：由安装器 / 部署流程把 @占位符@ 换成**部署期实测值**，落到声明里的 config_dir
#       （edge-intel 为 /etc/iraf/edge-intel.env）。铁律 6.3：端点/目录/超时只在本文件出现一次，
#       禁止在脚本或文档里再硬编码一份 —— 两份必然静默分叉。
#
# 部署期必须提供的值（缺任何一项都不要"猜一个"）：
#   @PROVIDER_ENDPOINT@  x86 仿真 Capability Provider 的 host:port（**部署期实测填入**；
#                        不要照抄任何示例 IP —— 板卡/主机地址会变）
#   @PROFILE@            RobotProfile 路径 = **这台算力设备实际驱动的机器人**（未定义时不得瞎填）
#   @SAFETY_POLICY@      SafetyPolicy 路径（板卡未签字前只能是仿真档：simulation_only=true）
#   @VERSION_DIR@        本域已装版本目录（如 /opt/iraf-sdk/current 解析后的版本目录）
#   @DATA_DIR@           数据目录（edge-intel 为 /var/lib/iraf）
#   @RUNTIME_SUBJECT@    调用方身份标识（审计用；身份本身来自受信 transport，不来自这里）
#
# **凭据绝不写入本文件**：`IRAF_PROVIDER_TOKEN` 只能由部署环境注入（进程环境/systemd 凭据），
# 不落盘、不进命令行、不进 git。缺 token 时两端都 fail-closed（服务端拒绝启动、客户端拒绝装配）。

IRAF_PROFILE=@PROFILE@
IRAF_SAFETY_POLICY=@SAFETY_POLICY@
IRAF_SKILL_ROOT=@VERSION_DIR@/skills

# 本域跑 TaskFlow → Skill Runtime → PolicyGateway（策略判定在**板上**）；
# 能力由 x86 仿真 Provider 执行并把画面显示在那边（见 .hermes/plans/2026-10-16-agentos-semantic-mcp-bridge.md）。
IRAF_BACKEND_ENTRYPOINT=iraf_adapters.remote.provider_backend:RemoteProviderBackend
IRAF_BACKEND_CONFIG={"endpoint":"@PROVIDER_ENDPOINT@","token_env":"IRAF_PROVIDER_TOKEN","timeout_s":180,"subject":"board-runtime"}

IRAF_EVENT_STORE=@DATA_DIR@/iraf-runtime.db
IRAF_RUNTIME_SUBJECT=@RUNTIME_SUBJECT@

# 板上（aarch64 Hyper 域）**没有显示设备**：不设 DISPLAY / MUJOCO_GL / LIBGL_ALWAYS_SOFTWARE。
# 窗口只出现在 x86 仿真主机；把窗口相关变量配到这里属于"仿真上板"的错误放置（AGENTS §0.1）。
#
# 仅当板上 IRAF 也要自己解析自然语言（即 AgentOS 只把文本转发过来）时，才需要再补两项：
#   IRAF_AGENTOS_MODEL_URL 与 IRAF_AGENTOS_MODEL（取值由部署期给）。
# 若由 AgentOS 侧完成语义解析、只传结构化任务，则不需要。
#
# 注意：渲染器会扫描**全文**（含注释）里的占位符并要求它有取值 —— 所以注释里不要写
# @大写占位符@ 的写法，否则渲染会因"该占位符没有取值"而显式失败。
