# IRAF 运行期单元模板（gRPC 跨域入口）—— 安装时由 install-iraf.sh 按声明渲染。
#
# 边界（AGENTS.md 1.4 / 2.11 / 6.11）：
#   · 本单元是**跨域版本化接口**的服务端；智能域用它接收任务，运控域用它暴露能力。
#   · 只允许绑定声明的地址（默认回环）；生产用 mTLS + 独立 netns，不得为图方便放宽绑定。
#   · 与 HTTP 单元同源渲染：机器相关的值一律走占位符，不得写死。

[Unit]
Description=IRAF runtime gRPC adapter (profile=@PROFILE@ version=@VERSION@)
Documentation=file:@PREFIX@/@CURRENT_LINK@/config/install/install_profiles.yaml
After=network.target
Requires=network.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@PREFIX@/@CURRENT_LINK@
Environment=PYTHONPATH=@PREFIX@/@CURRENT_LINK@/src:@PREFIX@/@CURRENT_LINK@/lib
EnvironmentFile=-@CONFIG_DIR@/@PROFILE@.env
# 凭据单独一个 600 文件（装配单按设计不写凭据；缺文件不致命 —— runtime 会因缺 token 显式失败）。
# 为什么不能省：板上 runtime 的 RemoteProviderBackend 需要 IRAF_PROVIDER_TOKEN，而 CLI/探针
# 不走 systemd ⇒ 新版 backend 还会读 IRAF_PROVIDER_TOKEN_FILE 兜底（2026-10-22 实机）。
EnvironmentFile=-@CONFIG_DIR@/provider.token
ExecStartPre=/bin/mkdir -p @LOG_DIR@ @DATA_DIR@
ExecStart=@PYTHON_BIN@ -m iraf_adapters.grpc.server
Restart=on-failure
RestartSec=3
# 独立资源限额（AGENTS 6.11）：值与声明里的 services[].cpu_quota / memory_max 一致；
# 渲染器在角色未声明限额时会把这两行整行删除（x86 开发档），边缘角色必须声明。
CPUQuota=@CPU_QUOTA@
MemoryMax=@MEMORY_MAX@
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@LOG_DIR@ @DATA_DIR@
UMask=0077

[Install]
WantedBy=multi-user.target
