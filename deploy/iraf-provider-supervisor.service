[Unit]
Description=IRAF Provider Supervisor (manifest-driven, one world at a time)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/coretek/iraf-instance
ExecStart=/usr/bin/python3 -u /home/coretek/iraf-instance/scripts/iraf_provider_supervisor.py --manifest /etc/iraf-agent/manifest.yaml --bind 127.0.0.1 --port 8770
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
