__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/*
!build/.gitkeep
o/
.venv/
.tmp/

# 厂商机器人模型：第三方代码，不入库。
# 通过 vendor/*/source-lock.json 锁定来源与哈希，需要时按锁文件重新拉取。
vendor/agilex_piper/piper_description
# source-lock.json 内含开发者本机的绝对路径，不适合入库。
vendor/*/source-lock.json

# 显示/调试产物的临时备份
*.bak

# MuJoCo 运行日志与调试截图：仿真产物，不入库。
MUJOCO_LOG.TXT
screenshot*.png
# 泛化/重构过程中的后端快照：原实现由 git 历史取回，不留在包目录。
*.pre-generalization

# Hermes Agent 工作区状态（计划、会话缓存等），不入库。
.hermes/
