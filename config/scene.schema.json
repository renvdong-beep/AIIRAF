        }
      }
    },
    "scene_baseline": {
      "type": "object",
      "additionalProperties": false,
      "title": "场景基线（iraf.scene-baseline/v1）",
      "description": "校验 scenes/<id>/baseline.yaml：参考姿态来源、各本体的机型基线引用与场景级验收阈值。阈值只来自声明与实测，禁止散落硬编码。",
      "required": [
        "schema_version",
        "scene",
        "robots",
        "initial_state",
        "acceptance",
        "sensor_acceptance"
      ],
      "properties": {
        "schema_version": {
          "const": "iraf.scene-baseline/v1"
        },
        "scene": {
          "$ref": "#/definitions/package_relative_path",
          "description": "必须指向本场景包自己的 scene.yaml（通常写 scene.yaml），不得指向别的包。"
        },
        "robots": {
          "type": "object",
          "minProperties": 1,
          "description": "每个本体到机型基线的引用；键集合必须与 scene.yaml 的 robots[].id **完全一致**（两处声明不一致即失败）。",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/repo_relative_path"
              },
              {
                "$ref": "#/definitions/unverified_ref"
              }
            ]
          }
        },
        "robots_joint": {
          "type": "object",
          "minProperties": 1,
          "description": "**联合世界**（多个本体装进同一份 MJCF、共享同一株植物）的机型绑定；键集合同样必须与 scene.robots[].id 完全一致。缺省不出现 ⇒ 单本体世界（默认行为逐位不变）。为什么单独一组：单本体产物与联合产物是**两个不同的模型**，验收数字不可互换（docs/debug/2026-09-24-joint-model-dog-arm.md §5/§10）。它同时声明了共享植物的角色与 owner（见各机型声明的 robot.plant 段）。",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/definitions/repo_relative_path"
              },
              {
                "$ref": "#/definitions/unverified_ref"
              }
            ]
          }
        },
        "initial_state": {
          "type": "object",
          "minProperties": 1,
          "description": "各本体初始状态；键集合同样必须与 scene.robots[].id 一致。pose_source=unverified 表示参考位形尚未确定，必须写 closed_by/reason（执行器在回填前不得启动该本体）。",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pose_source"
            ],
            "properties": {
              "pose_source": {
                "enum": [
                  "profile",
                  "explicit",
                  "unverified"
                ],
                "description": "profile=参考姿态来自各本体 profile.home（不复制数字，避免两份事实）；explicit 时必须给出 joints；unverified=尚未确定，必须写 closed_by/reason。"
              },
              "joints": {
                "type": "object",
                "minProperties": 1
              },
              "closed_by": {
                "type": "string",
                "pattern": "^步骤 [0-9]{2}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "pose_source": {
                      "const": "explicit"
                    }
                  },
                  "required": [
                    "pose_source"
                  ]
                },
                "then": {
                  "required": [
                    "joints"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "pose_source": {
                      "const": "unverified"
                    }
                  },
                  "required": [
                    "pose_source"
                  ]
                },
                "then": {
                  "required": [
                    "closed_by",
                    "reason"
                  ]
                }
              }
            ]
          }
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pose_tolerance_m",
            "min_lift_delta_m",
            "min_stable_hold_s",
            "dock_translation_error_max_m",
            "dock_yaw_error_max_deg",
            "max_speed_m_s"
          ],
          "description": "场景级验收阈值；判据来自设计 §4（停靠 ≤30mm / ≤2deg、速度为零、抓取双指接触 + 抬升）。",
          "properties": {
            "pose_tolerance_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_lift_delta_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_stable_hold_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dock_translation_error_max_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dock_yaw_error_max_deg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_speed_m_s": {
              "type": "number",
              "minimum": 0
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "sensor_acceptance": {
          "type": "object",
          "additionalProperties": false,
          "title": "传感器验收阈值（步骤 14）",
          "description": "`scripts/verify_scene_sensors.py` 消费的全部阈值。**必需段**：缺段或缺键即声明非法，禁止脚本内写死默认值（AGENTS.md 1.3 / 铁律 5.3）。数值的实测依据写在 scenes/<id>/baseline.yaml 的注释里。",
          "required": [
            "settle",
            "camera",
            "lidar",
            "imu"
          ],
          "properties": {
            "settle": {
              "type": "object",
              "additionalProperties": false,
              "description": "采样前的仿真推进窗口；用于证明状态可复现且准静态，不代表步态/平衡能力。",
              "required": [
                "steps",
                "max_base_drift_m"
              ],
              "properties": {
                "steps": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_base_drift_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "camera": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_vs_declaration_rel_error_max",
                "calibration_fovy_rel_error_max",
                "calibration_focal_rel_error_max",
                "resolution_tolerance_px",
                "min_nonblack_fraction"
              ],
              "properties": {
                "model_vs_declaration_rel_error_max": {
                  "type": "number",
                  "minimum": 0
                },
                "calibration_fovy_rel_error_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "calibration_focal_rel_error_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "resolution_tolerance_px": {
                  "type": "integer",
                  "minimum": 0
                },
                "min_nonblack_fraction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            },
            "lidar": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "elevation_rings_deg",
                "range_histogram_edges_m",
                "ground_geoms",
                "min_points",
                "max_miss_fraction",
                "min_ground_fraction",
                "workbench_geometry_tolerance_m",
                "ray_box_tolerance_m"
              ],
              "properties": {
                "elevation_rings_deg": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                },
                "range_histogram_edges_m": {
                  "type": "array",
                  "minItems": 2,
                  "description": "量程直方图的边界（米）；首个边界可以是 0（从 0 m 起分箱），实现层强制严格递增。",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "ground_geoms": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "min_points": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_miss_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "min_ground_fraction": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "workbench_geometry_tolerance_m": {
                  "type": "number",
                  "minimum": 0
                },
                "ray_box_tolerance_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "imu": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quat_norm_tolerance",
                "gyro_max_abs_error_rad_s",
                "acc_rel_error_max",
                "torque_max_abs_error_nm"
              ],
              "properties": {
                "quat_norm_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "gyro_max_abs_error_rad_s": {
                  "type": "number",
                  "minimum": 0
                },
                "acc_rel_error_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "torque_max_abs_error_nm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      },
      "definitions": {
        "package_relative_path": {
          "type": "string",
          "pattern": "^(?!/)[A-Za-z0-9._][A-Za-z0-9._/-]*$",
          "not": {
            "pattern": "\\.\\."
          },
          "description": "场景包内相对路径（副本必须保持可校验）。"
        },
        "repo_relative_path": {
          "type": "string",
          "pattern": "^(?!/)[A-Za-z0-9._][A-Za-z0-9._/-]*$",
          "not": {
            "enum": [
              "pending",
              "tbd",
              "unknown",
              "?",
              "n/a",
              "unverified"
            ]
          },
          "description": "仓库相对路径；模糊占位不是路径，未交付只能写结构化的 {state: unverified, closed_by, reason}。"
        },
        "unverified_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "closed_by",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unverified"
            },
            "closed_by": {
              "type": "string",
              "pattern": "^步骤 [0-9]{2}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scenario_catalog": {
      "type": "object",
      "additionalProperties": false,
      "title": "场景脚本目录（iraf.scenario-catalog/v1）",
      "description": "校验 scenes/<id>/scenario.yaml：S2 脚本化场景（决策 6.A）。本步骤只声明与校验，执行器由步骤 18 的 scripts/scenario.py 交付；在它落地前不得在文档里声称该命令可用（AGENTS.md 6.4）。",
      "required": [
        "schema_version",
        "scene",
        "simulation",
        "scenarios"
      ],
      "properties": {
        "schema_version": {
          "const": "iraf.scenario-catalog/v1"
        },
        "scene": {
          "type": "string",
          "pattern": "^(?!/)[A-Za-z0-9._][A-Za-z0-9._/-]*$",
          "not": {
            "pattern": "\\.\\."
          },
          "description": "必须指向本场景包自己的 scene.yaml。"
        },
        "simulation": {
          "const": true
        },
        "scenarios": {
          "type": "object",
          "minProperties": 1,
          "description": "命名的场景序列，与设计 §3 的 `scripts/scenario.py run --scenario <name>` 对应。",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "steps",
              "faults"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/step"
                }
              },
              "faults": {
                "type": "array",
                "description": "故障注入项。期望终态必须来自 TaskFlow 既有状态词表，且 fake_success_forbidden 恒为 true（AGENTS.md 1.5：禁止伪造成功）。",
                "items": {
                  "$ref": "#/definitions/fault"
                }
              }
            }
          }
        }
      },
      "definitions": {
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "action",
            "robot",
            "params",
            "criteria"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "action": {
              "enum": [
                "stand",
                "stop",
                "locomote",
                "navigate",
                "dock_for_handoff",
                "accept_payload",
                "pick_object",
                "place_object",
                "move_joint",
                "visual_pick"
              ],
              "description": "Skill 名（设计 §4 的能力合约）。新增 Skill 必须先改本契约再实现。"
            },
            "robot": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "必须是 scene.yaml 里已声明的本体 id。"
            },
            "params": {
              "type": "object",
              "description": "Skill 参数（只能收紧安全边界，不能放宽，铁律 1.3）。"
            },
            "pending_closed_by": {
              "type": "string",
              "pattern": "^步骤 [0-9]{2}$",
              "description": "该步用到的能力尚未交付时，必须显式登记关闭它的步骤；scene_check 会拒绝「声明了本体未具备的能力却没有待交付登记」的步骤。"
            },
            "pending_reason": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "object",
              "description": "该步的**成功判据**（不是「命令已发出」）。键名必须来自既有判据集合，避免同义字段扩散。",
              "propertyNames": {
                "enum": [
                  "pose_tolerance_m",
                  "min_lift_delta_m",
                  "min_stable_hold_s",
                  "max_speed_m_s",
                  "translation_error_max_m",
                  "yaw_error_max_deg",
                  "require_payload_confirmation",
                  "timeout_s",
                  "require_bilateral_contact",
                  "max_offset_from_tray_center_m",
                  "require_release",
                  "require_payload_in_tray",
                  "max_accept_offset_m",
                  "max_accept_speed_mps"
                ]
              },
              "additionalProperties": {
                "type": [
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "allOf": [
            {
              "description": "待交付登记必须成对出现（缺 reason 的占位等于没有登记）。",
              "if": {
                "required": [
                  "pending_closed_by"
                ]
              },
              "then": {
                "required": [
                  "pending_reason"
                ]
              }
            }
          ]
        },
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "at_step",
            "kind",
            "target",
            "expect"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "at_step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "注入时机：必须是同一 scenario 内已声明的步骤 id。"
            },
            "kind": {
              "enum": [
                "sensor_unavailable",
                "actuator_timeout",
                "authority_conflict",
                "state_stale",
                "estop"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "terminal_state",
                "fake_success_forbidden"
              ],
              "properties": {
                "terminal_state": {
                  "enum": [
                    "SUCCEEDED",
                    "FAILED",
                    "CANCELLED",
                    "SAFETY_STOP",
                    "SAFE_HOLD",
                    "HANDOVER_REQUIRED"
                  ],
                  "description": "TaskFlow 状态词表（docs/iraf-taskflow-policy-detailed-design.md §状态机）：非终态 SAFE_HOLD/HANDOVER_REQUIRED，终态 SUCCEEDED/FAILED/CANCELLED/SAFETY_STOP。"
                },
                "fake_success_forbidden": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  }
}
