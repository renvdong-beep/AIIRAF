        },
        "range_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mount_height_m": {
          "type": "number"
        },
        "rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "description": "相机必须有安装位姿、注视点与垂直视场角（标定与内参校验需要，缺一即不可复算）。",
