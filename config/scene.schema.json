{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IRAF 场景包契约（scene / scene-baseline / scenario-catalog 三份子契约）",
  "description": "场景是**声明**而不是代码（docs/iraf-unitree-scenario-interaction-design.md §3，决策 5.A）。同一文件内交付三份彼此独立的契约：根结构校验 scenes/<id>/scene.yaml；definitions.scene_baseline 校验 scenes/<id>/baseline.yaml；definitions.scenario_catalog 校验 scenes/<id>/scenario.yaml。三份契约合并在一个文件，是因为步骤 plans/iraf-24h/11 声明的交付路径只有本文件；后两份子契约各自把自己需要的辅助定义**嵌套**在自己的 definitions 下（definitions.<子契约>.definitions.*），内部一律使用相对 $ref（#/definitions/<name>），因此可以整体提取后单独校验（scripts/scene_check.py 与 tests/unit/test_scene_schema.py 都这样做）；不要从根结构再用 $ref 指向它们，否则其内部相对引用会解析到根的 definitions。fail-closed 约定：场景里尚未交付的引用（本体 profile、场景构建器）只能写成 {state: unverified, closed_by, reason} 显式占位，缺 reason 即不合法；仿真结论必须带 simulation: true（AGENTS.md 1.7）；人形只能是静态模型（决策 4.B，见 scene_robot 的 allOf）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "simulation",
    "seed",
    "terrain",
    "robots",
    "props",
    "sensors",
    "lights",
    "model"
  ],
  "properties": {
    "schema_version": {
      "const": "iraf.scene/v1",
      "description": "场景契约版本；改结构必须同步升版本并在同一变更内更新本 schema。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "场景 id，必须与目录名 scenes/<id>/ 一致（scene_check.py 强制）。"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "simulation": {
      "const": true,
      "description": "仿真场景必须显式声明 true；缺失即不合法（不得默认 true，也不得用仿真结果冒充真机能力，AGENTS.md 1.7）。"
    },
    "plant_demand_gate": {
      "type": "boolean",
      "description": "**共享植物的推进口径**（联合世界必须声明，见 docs/debug/2026-09-24-joint-model-dog-arm.md §11.87）。true = 装\"需求闸门\"：guest（臂）执行步骤期间，owner 的**自由推进线程**（植物驻留）只在 guest 登记了\"要推进到第几步\"时才推进，且最多推进到该目标；没有 guest 在等就一步都不推。false = 旧行为（驻留线程在 guest 等待期间并发 mj_step ⇒ 实际推进 = 请求量 + **挂钟决定的超出量**，实测 17×）。**联合世界必须显式为 true**：false 会让\"每次运行的初始状态都不同\"，即验收本身不可复现（实测同一配置 B 站末态在 1.8785~5.2865° 之间跳；置 true 后两站逐位复现）。"
    },
    "world_physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cone",
        "impratio"
      ],
      "description": "**物理口径**（存在附加本体的联合世界必须声明，见 docs/debug/2026-09-24-joint-model-dog-arm.md §11.23）。合成产物的 <option> 会从主模型（厂商四足模型 vendor/unitree_go2/.../go2.xml:4）继承 cone=elliptic impratio=100，而同一台臂在自己的世界里用的是 MuJoCo 默认 cone=pyramidal impratio=1 ⇒ 夹持/接触类结论跨世界不可移植。数值只来自本声明，构建器不写默认值；缺声明即拒绝构建（scene_builder._apply_world_physics），并要求读回实测值一致。",
      "properties": {
        "cone": {
          "enum": [
            "pyramidal",
            "elliptic"
          ],
          "description": "摩擦锥近似：pyramidal 内接（对角方向最差 0.707μN），elliptic 为完整 μN。"
        },
        "impratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "摩擦约束阻抗与法向阻抗之比（MuJoCo 默认 1）。"
        },
        "timestep": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gravity": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "randomization"
      ],
      "description": "随机种子；randomization=true 时必须先补齐随机化验收证据（本轮声明为 false）。",
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0
        },
        "randomization": {
          "type": "boolean"
        }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "friction",
        "workbench"
      ],
      "properties": {
        "kind": {
          "enum": [
            "flat"
          ],
          "description": "首期只声明平地地形；地形道具随场景构建器（步骤 13）扩展，扩展前不得声明。"
        },
        "friction": {
          "$ref": "#/definitions/friction"
        },
        "workbench": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "top_z_m",
            "half_size_m",
            "half_thickness_m",
            "friction"
          ],
          "description": "工作台几何，字段名与 config/*_simulation_baseline.yaml 的 workbench 段一致（复用既有字段名，不新造同义字段）。",
          "properties": {
            "top_z_m": {
              "type": "number"
            },
            "half_size_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "half_thickness_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "friction": {
              "$ref": "#/definitions/friction"
            }
          }
        }
      }
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "description": "场景内本体清单。capabilities 是**已交付能力**的声明，不是期望值：未验收的能力不得写进来。",
      "items": {
        "$ref": "#/definitions/scene_robot"
      }
    },
    "props": {
      "type": "array",
      "description": "道具清单（盒体/托盘/支架）。几何必须是内联基元或已存在的 mesh 文件（mesh 文件不存在即引用完整性失败）。",
      "items": {
        "$ref": "#/definitions/scene_prop"
      }
    },
    "frames": {
      "type": "array",
      "description": "世界固定参考系（导航/停靠/交接的目标帧）：注入为 worldbody 下的 site。停靠目标帧**必须**世界固定且不与机器人刚性相连 —— 挂在机器人身上的帧会让误差恒为自指量（实测：偏航恒 0、平移 = 帧本地偏置的投影，见 docs/debug/2026-09-24-dock-target-self-frame.md）。",
      "items": {
        "$ref": "#/definitions/scene_world_frame"
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "description": "传感器声明。厂商 MJCF 不提供相机/雷达（实测 go2.xml 无 camera、无雷达），因此 source=scene 的传感器必须由场景构建器按本声明注入，禁止写死进厂商文件。",
      "items": {
        "$ref": "#/definitions/scene_sensor"
      }
    },
    "lights": {
      "type": "array",
      "minItems": 1,
      "description": "光照是检测链路的输入而不是装饰（docs/debug/2026-09-20-scene-lighting-declaration.md）：空声明会让离屏图像近全黑，因此空数组即不合法。",
      "items": {
        "$ref": "#/definitions/scene_light"
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "builder"
      ],
      "description": "生成模型输出路径与构建器引用。输出必须落在 build/ 或 artifacts/ 下（AGENTS.md 5.5：构建产物不得污染源码目录）。",
      "properties": {
        "output": {
          "type": "string",
          "pattern": "^(build|artifacts)/[A-Za-z0-9._/-]+\\.xml$"
        },
        "joint_output": {
          "type": "string",
          "pattern": "^(build|artifacts)/[A-Za-z0-9._/-]+\\.xml$",
          "description": "联合模型（多本体合成，`--attach <本体>`）的输出路径；单本体产物仍写 `output`。"
        },
        "joint_manipulator": {
          "type": "string",
          "description": "联合报告顶层 `manipulation`/`gripper`/`targets` 描述**哪一台**附加机械臂（`robots[].id`）。`--attach` 里有多台本体声明了 `manipulation_report` 时**必须**给出（否则构建器显式失败），单台时可省略。取值不接受按 `--attach` 顺序隐式推断。"
        },
        "attached_actuator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["armature_min_kg_m2"],
          "properties": {
            "armature_min_kg_m2": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "**附加本体**关节的转子惯量下限（kg·m²）：装配后按 `armature := max(厂商值, 本下限)` 注入，**只对附加本体**（主本体与整株步长都不碰）。为什么必须（2026-09-30 §11.35/§11.37）：显式积分下 PD 位置伺服的稳定性由 `kv·dt/J` 决定，UR5e 厂商标定（kp=2000/500、kv=400/100）在小惯量腕关节上远超稳定界 ⇒ 逐步数值颤动（实测肘 qvel 每 2 步翻符号、周期 = 2.008·dt、wrist_2 全程饱和、静态保持残余 0.049657413 rad）；实测需 ≥ 0.5 才进入稳定区（残余 −8.2e-08 rad），且不动 kp/kv 的厂商标定。缺省不注入（行为与改动前一致）。"
            }
          }
        },
        "builder": {
          "$ref": "#/definitions/unverified_or_path",
          "description": "场景构建器入口：要么是已存在的仓库相对路径，要么是显式 unverified 占位（占位会进 scene_check 的 pending_refs，不是静默忽略）。"
        }
      }
    }
  },
  "definitions": {
    "friction": {
      "type": "string",
      "pattern": "^[0-9.]+ [0-9.]+ [0-9.]+$",
      "description": "MuJoCo 摩擦三元组（滑动 扭转 滚动），写法与既有基线一致。"
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "rgba": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "package_relative_path": {
      "type": "string",
      "pattern": "^(?!/)[A-Za-z0-9._][A-Za-z0-9._/-]*$",
      "not": {
        "pattern": "\\.\\."
      },
      "description": "场景包内相对路径：不得是绝对路径、不得含 ..（越界即显式失败）。"
    },
    "repo_relative_path": {
      "type": "string",
      "pattern": "^(?!/)[A-Za-z0-9._][A-Za-z0-9._/-]*$",
      "not": {
        "anyOf": [
          {
            "pattern": "pypi\\.org"
          },
          {
            "enum": [
              "pending",
              "tbd",
              "unknown",
              "?",
              "n/a",
              "unverified"
            ]
          }
        ]
      },
      "description": "仓库相对路径（本体 profile 等），禁止绝对路径；pending/tbd/unknown 等模糊占位与本字面量 unverified 都不是路径，未交付只能写结构化的 {state: unverified, closed_by, reason}。"
    },
    "unverified_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "closed_by",
        "reason"
      ],
      "description": "尚未交付的引用必须显式占位，不得猜测路径、不得静默省略；reason 为空即不合法。",
      "properties": {
        "state": {
          "const": "unverified"
        },
        "closed_by": {
          "type": "string",
          "pattern": "^步骤 [0-9]{2}$",
          "description": "关闭该缺口的那一步（plans/iraf-24h/NN-*.md）。"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unverified_or_path": {
      "oneOf": [
        {
          "$ref": "#/definitions/repo_relative_path"
        },
        {
          "$ref": "#/definitions/unverified_ref"
        }
      ],
      "description": "要么是已存在的仓库相对路径，要么是显式 unverified 占位（字符串与对象互斥，无重叠分支）。"
    },
    "scene_robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "profile",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "arm",
            "quadruped",
            "humanoid"
          ]
        },
        "role": {
          "enum": [
            "manipulator",
            "carrier",
            "scene_entity"
          ]
        },
        "profile": {
          "$ref": "#/definitions/unverified_or_path"
        },
        "manipulation_report": {
          "type": "string",
          "description": "继承 manipulation 事实（gripper/targets）的臂侧场景报告路径；仅 `--attach` 时消费。"
        },
        "reference_solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "entry",
            "baseline"
          ],
          "description": "联合模式的**参考姿态求解器**：继承来的 home/approach/grasp/lift_positions 是臂自己基座系下的关节解，附加本体一有 placement 就不适用（实测残差 0.367696068 m）⇒ 必须按本场景重解。缺声明即失败，不静默继承。",
          "properties": {
            "module": {
              "type": "string",
              "description": "仓内脚本路径（构建器按声明动态加载；模块/机型名不写进构建器，AGENTS.md 6.3）。"
            },
            "entry": {
              "type": "string",
              "description": "求解入口，契约：entry(root, baseline_doc, target_xy_override_m=[x,y], target_z_override_m=z) → {home, approach, grasp, lift} + finger_height_correction_m（= 该场景下的 pad_offset_m）。"
            },
            "place_entry": {
              "type": "string",
              "description": "可选入口，契约：place_entry(root, baseline_doc, target_local_m, payload_half_m, pad_offset_m, clearance_m) → {poses: {above/descend/retreat: 关节解}}；构建期解出**放置四段**的关节空间解（后端只回放），理由见 docs/debug/2026-09-24-joint-model-dog-arm.md §11.16。"
            },
            "place_target_id": {
              "type": "string",
              "minLength": 1,
              "description": "**放置接收体**（可选）：构建期放置求解器要用 `place_targets.targets` 里的哪一个接收体。缺省 = 取第一个带 nominal_pose_m/size_m 的（旧行为，逐位不变）。为什么必须可声明（§11.57 实测）：联合报告里 tray_01 排在 place_pad_b 前面，first-fit 会让「该放落点垫」的臂也按**托盘**求解 ⇒ 下行段几乎不动（肩抬升只差约 25 mrad），运行期报「触地纠偏需要竖向移动 -0.316 m > max_vertical_m」——这是「求解目标错了」，不是上限太小。必须与 scenario.yaml 里运行期的 place_target_id 指向同一接收体。"
            },
            "place_carrier_frame": {
              "type": "string",
              "minLength": 1,
              "description": "**放置时载体（狗）停在哪一站**（可选，写成模型里的 worldbody 帧名，如 handoff_station_frame_b）。缺省 = 用模型里的**载体初始位姿**（旧行为，逐位不变）。为什么必须可声明（§11.63 实测）：构建期的航点/路径自检是在「载体在出生点」的 FK 上做的，而运行期碰撞发生在**狗停到站位**时（实测 UR5e 腕部本体撞狗前左髋 FL_hip ×80、撞托盘 ×69、撞底座 ×121）⇒ 不声明站位时，这类碰撞**结构上看不见**，只能运行期才炸。声明后构建期把载体摆到该帧位姿再 FK，净空数字才有意义。"
            },
            "feedforward_entry": {
              "type": "string",
              "description": "可选入口，契约：feedforward_entry(model, reference, baseline_doc, prefix) → ({相位: {模型内关节名: ctrl 增量}}, 证据)；用于在**运行期同款模型**上重算重力前馈（两个模型的执行器增益不同 ⇒ 继承值按增益比例失真）。"
            },
            "baseline": {
              "type": "string",
              "description": "求解器自己的声明配置路径（机型数字的唯一事实来源；本文件不复制）。"
            },
            "target_override_world_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "该臂在**本联合场景**里的抓取目标（世界系 xyz）。缺省 = 用场景道具的默认位置。用于臂的基座/朝向与默认目标不匹配的情形（实测 UR5e：默认目标距基座 1.18 m 超出可达 1.05 m ⇒ 姿态翻到反向分支）。"
            },
            "baseline_overrides": {
              "type": "object",
              "minProperties": 1,
              "description": "**本场景对求解器基线配置的覆盖**（嵌套对象，按层深合并到 `baseline` 读出的文档上再传给求解器）。用途：同一台臂在不同场景里可达的工作空间不同（实测 UR5e：基线的 `grasp.home_rise_m: 0.30` 在它自己的场景里得到 home 残差 1.5e-07，换到本联合场景（目标距基座 0.45 m、载荷在托盘中）后 home 目标不可达 ⇒ 残差 4.15e-01 m、home 位形压在载荷里 31.6 mm）。**覆盖必须由场景声明**，且构建期会把生效值与来源写进报告；缺省不覆盖（逐位不变）。"
            }
          }
        },
        "profile_name": {
          "type": "string",
          "description": "场景 id 与 Profile 身份不同名时的**显式映射**（值必须等于 Profile 的 metadata.name，仍是硬校验）。"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "该本体在本场景中声明可用的能力。分派层按能力而不是机型名选择 Provider。"
        },
        "capabilities_unverified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closed_by",
            "reason"
          ],
          "properties": {
            "closed_by": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "「本本体已装配进本场景、但**在本场景**尚无任何已验收能力」的显式声明（与 capabilities 为空配对）。存在理由（2026-09-29 实测）：Profile 已交付的本体被要求至少声明一项能力，而把臂装配进联合世界（同一 MJCF/共享植物）本身不需要任何技能验收 —— 此时**不允许**塞一个假能力充数，也不允许退回 profile 占位（构建器要从该 Profile 取模型/关节/夹爪声明）。填法示例：{closed_by: \"I1 增量\", reason: \"只验证能进同一物理世界\"}。"
        },
        "model_only": {
          "type": "boolean"
        },
        "evidence_level": {
          "type": "string",
          "description": "人形等静态实体必须写「仅模型」（英文键 + 中文取值，设计 §10）。"
        },
        "note": {
          "type": "string"
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pos_m",
            "quat_wxyz"
          ],
          "description": "联合模型里的相对位姿（世界系）：仅 `--attach <本体>` 时被消费；单本体产物不受影响。",
          "properties": {
            "pos_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "quat_wxyz": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "description": "已交付 profile 的本体必须至少声明一项能力；未交付（unverified）的本体允许空能力数组；已装配但**本场景未验收**任何能力时，用 capabilities: [] + capabilities_unverified 显式声明（见该键说明）。",
          "if": {
            "properties": {
              "profile": {
                "type": "string"
              }
            },
            "required": [
              "profile"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "capabilities": {
                    "minItems": 1
                  }
                }
              },
              {
                "required": [
                  "capabilities_unverified"
                ],
                "properties": {
                  "capabilities": {
                    "maxItems": 0
                  }
                }
              }
            ]
          }
        },
        {
          "description": "静态模型（model_only=true）只能声明 static_model_only：不得声明任何运动/操作能力（决策 4.B 硬约束）。",
          "if": {
            "properties": {
              "model_only": {
                "const": true
              }
            },
            "required": [
              "model_only"
            ]
          },
          "then": {
            "required": [
              "evidence_level"
            ],
            "properties": {
              "capabilities": {
                "items": {
                  "const": "static_model_only"
                }
              },
              "evidence_level": {
                "const": "仅模型"
              }
            }
          }
        },
        {
          "description": "声明了 manipulation_report 的本体必须同时声明 placement 与 reference_solver：继承来的参考姿态是**场景专属**的（取决于本体的 placement 与本场景的目标几何），联合构建必须按声明重解；静默继承曾造成 0.367696068 m 的抓取残差。",
          "if": {
            "properties": {
              "manipulation_report": {
                "type": "string"
              }
            },
            "required": [
              "manipulation_report"
            ]
          },
          "then": {
            "required": [
              "placement",
              "reference_solver"
            ]
          }
        },
        {
          "description": "人形（humanoid）在本战役只能是静态模型，必须显式写 model_only=true 与 evidence_level=仅模型。",
          "if": {
            "properties": {
              "kind": {
                "const": "humanoid"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "model_only",
              "evidence_level"
            ],
            "properties": {
              "model_only": {
                "const": true
              },
              "evidence_level": {
                "const": "仅模型"
              }
            }
          }
        }
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
