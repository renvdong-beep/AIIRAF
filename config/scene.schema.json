    "scene_prop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "body",
        "kind",
        "geometry",
        "mass_kg",
        "friction",
        "rgba",
        "pose"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "body": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "生成模型里该道具的 body 名（抓取判据按 body 命中，不能用 id 替代）。"
        },
        "kind": {
          "enum": [
            "box",
            "tray",
            "stand"
          ]
        },
        "geometry": {
          "$ref": "#/definitions/geometry"
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "friction": {
          "$ref": "#/definitions/friction"
        },
        "rgba": {
          "$ref": "#/definitions/rgba"
        },
        "pose": {
          "$ref": "#/definitions/pose"
        },
        "note": {
          "type": "string"
        },
        "receiving": {
          "type": "boolean",
          "description": "**该道具是否为放置接收体**（2026-09-28 §11.23(38)）：带 `pose.mount` 的道具默认是接收体（随载体运动）；**世界固定**的道具（如台面上的托盘）必须显式 `receiving: true`，否则不会被当作接收体 —— 也不能放宽成『任何有 pose.pos_m 的道具』，否则载荷自身会被误当接收体（实测 targets[0] 变成方块自己）。"
        },
        "static": {
          "type": "boolean",
          "description": "**该道具是否为静态支撑体**（2026-09-28 §11.23(41)）：true ⇒ 注入到 worldbody 但**不带 freejoint**（刚接到世界，不参与动力学，因此不会下落、不会被推动）；false/缺省 ⇒ 世界固定的**自由体**（带 freejoint，会自由落体）。为什么需要它：把交接面抬到台面之上必须有支撑结构，而自由体台架会直接掉下来；同时静态体的位姿完全确定 ⇒ 构建期解出的放置位形在运行期逐位有效（见 `place_object` 的搬运自锁根因）。"
        }
      }
    },
    "scene_world_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "pose"
      ],
      "description": "世界固定参考系：只有 site 一种形态（无质量、无自由关节、不参与碰撞 ⇒ 不会被推走，也不占台面）。pose 必须显式给出（世界系），不允许 `mount`。",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
