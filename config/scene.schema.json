              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "quat_wxyz": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "scene_sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "anchor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "camera",
            "lidar",
            "imu"
          ]
        },
        "source": {
          "enum": [
            "vendor",
            "scene"
          ],
          "description": "vendor=厂商 MJCF 自带（如 go2 的 imu site）；scene=由场景构建器按本声明注入。"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_kind",
            "name",
            "entity"
          ],
          "description": "传感器挂在生成模型里的哪个对象上。object_kind=site/geom/body/camera，name 必须在生成后的模型里真实存在（--model 时校验）；entity 必须是本场景已声明的本体 id。",
          "properties": {
            "object_kind": {
              "enum": [
                "camera",
                "site",
                "geom",
                "body"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
            },
