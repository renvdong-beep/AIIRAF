              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "pos_m": {
          "$ref": "#/definitions/vec3"
        },
        "look_at_m": {
          "$ref": "#/definitions/vec3"
        },
        "fovy_deg": {
          "type": "number",
          "exclusiveMinimum": 1,
          "exclusiveMaximum": 179
        },
        "num_rays": {
          "type": "integer",
