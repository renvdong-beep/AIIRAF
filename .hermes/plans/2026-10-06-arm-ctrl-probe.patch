+            _arm_log = getattr(_backend, "_arm_ctrl_log", None)
+            if _arm_log:
+                print("PLANT_ARM_CTRL " + json.dumps(
+                    {"robot": str(_rid), "writes": _arm_log}, ensure_ascii=False), flush=True)
     return records
 
 
