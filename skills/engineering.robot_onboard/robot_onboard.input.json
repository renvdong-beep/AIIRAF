{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["robot_id"],
  "additionalProperties": false,
  "properties": {
    "stage": {"enum": ["onboard", "scaffold", "scene", "acceptance", "acceptance_all", "join_world", "register", "status"], "default": "onboard"},
    "robot_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
    "model_path": {"type": "string", "description": "MJCF 路径（相对仓库根或绝对）"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "default": []},
    "capability": {"type": "string", "description": "scaffold/acceptance 阶段的能力名"},
    "profile": {"type": "string", "description": "scene/acceptance 阶段的 Profile 路径"},
    "scene_id": {"type": "string"},
    "robots": {"type": "string", "description": "join_world：逗号分隔的机器人 id"},
    "base": {"type": "string", "description": "join_world：基础联合场景目录"},
    "require_runnable": {"type": "boolean", "default": true},
    "register": {"type": "boolean", "default": false},
    "build": {"type": "boolean", "default": false},
    "build_primary": {"type": "string"},
    "provider_endpoint": {"type": "string"},
    "report_path": {"type": "string"},
    "backend_entrypoint": {"type": "string"},
    "backend_config": {"type": "object"},
    "control_url": {"type": "string"},
    "safety_policy": {"type": "string"},
    "params": {"type": "object", "description": "acceptance 能力参数"},
    "scene_file": {"type": "string"},
    "provider_file": {"type": "string"},
    "acceptance_report": {"type": "string"},
    "registry_root": {"type": "string"},
    "profiles_root": {"type": "string"},
    "dry_run": {"type": "boolean", "default": true},
    "allow_overwrite": {"type": "boolean", "default": false},
    "output_dir": {"type": "string", "default": ""}
  }
}
