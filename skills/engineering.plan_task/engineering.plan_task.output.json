{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "planned", "physics"],
  "additionalProperties": true,
  "properties": {
    "status": {"type": "string", "enum": ["SUCCEEDED", "FAILED"]},
    "planned": {"const": true},
    "physics": {"const": false},
    "backend": {"const": "kinematic"},
    "scene": {"type": "string"},
    "target": {"type": "object"},
    "approach": {"type": "object"},
    "ik": {"type": "object"},
    "limits": {"type": "object"},
    "gripper": {"type": "object"},
    "timing": {"type": "object"},
    "model": {"type": "object"},
    "report": {"type": "object"},
    "error_code": {"type": "string"},
    "reason": {"type": "string"}
  }
}