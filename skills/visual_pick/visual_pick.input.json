{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "target_id"
  ],
  "additionalProperties": false,
  "properties": {
    "target_id": {
      "type": "string",
      "minLength": 1,
      "description": "要抓取的载荷 id（ASCII：如 box_01）。自然语言『盒子/方块/box』指默认载荷 box_01。"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 30000
    },
    "vision_file": {
      "type": "string",
      "minLength": 1,
      "description": "视觉目标证据文件路径，缺省由 Backend 使用默认路径"
    }
  }
}
