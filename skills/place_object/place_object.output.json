{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "skill",
    "accepted",
    "place_target_id",
    "payload_id",
    "confirmation"
  ],
  "additionalProperties": false,
  "properties": {
    "skill": {
      "const": "place_object"
    },
    "accepted": {
      "const": true
    },
    "place_target_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_id": {
      "type": "string",
      "minLength": 1
    },
    "confirmation": {
      "enum": [
        "released"
      ],
      "description": "放置的确认口径：**只有 `released`**（夹爪张开且载荷确实落在接收体上）。不接受\"命令已发出\"或\"轨迹已执行\"作为确认。"
    },
    "evidence": {
      "type": "object",
      "required": [
        "place_target_body",
        "payload_body",
        "released",
        "payload_in_tray"
      ],
      "additionalProperties": false,
      "properties": {
        "arm_joint_positions": {
          "type": [
            "object",
            "null"
          ],
          "description": "搬运各相位结束时**臂关节实测 qpos**（对象：关节名 → 弧度）。用于与报告里的 `place_*_positions` 逐关节对账 —— 2026-09-28 §11.23(39) 实测到「回放执行了但臂没位移」（指腹停在 (0.3059,-0.3126,0.0839) vs 托盘 (0.309,-0.591,0.02)），而构建期对同批位形的 FK 验证达标（残差 8.041e-06）⇒ 需要关节级证据分清是「回放没下发」还是「下发了没到位」。"
        },
        "carry_cadence": {
          "type": "object",
          "required": [
            "declared_limit",
            "max_plant_steps_per_iteration"
          ],
          "additionalProperties": false,
          "properties": {
            "declared_limit": {
              "type": "integer",
              "minimum": 1,
              "description": "声明的节拍上限（carry_constraint.max_plant_steps_per_iteration）。"
            },
            "max_plant_steps_per_iteration": {
              "type": "integer",
              "minimum": 0,
              "description": "实测：单次控制迭代内植物前进的最大步数（anchor 每迭代只跟随一次，步数越大载荷挂陈旧 anchor 越久；超过声明上限即显式失败）。"
            },
            "iterations": {
              "type": "integer",
              "minimum": 0,
              "description": "统计到的控制迭代次数。"
            },
            "last_delta": {
              "type": "integer",
              "description": "最后一次迭代的植物步进数。"
            },
            "within_declared_limit": {
              "type": "boolean",
              "description": "实测最大值是否在声明阈值内（**诊断标注，不是判据**：本机节拍随负载波动，同一场景两次运行分别测到 25 / 40 步，故不拿它当硬门禁；被强制的不变量是滑移）。"
            }
          },
          "description": "搬运段的节拍实测（诊断量）：证明「载荷随指腹刚性搬运」的前提被真实观测到。节拍随机器负载变化 ⇒ 只记录 + 标注，不判失败；超滑移时的报错会一并给出节拍数字。"
        },
        "carry_constraint_activated": {
          "type": "boolean",
          "description": "搬运段是否按声明启用了**抓取约束**（MuJoCo `<connect>` 焊接 + mocap anchor）。动机：本几何下唯一撑得住抬升的斜夹过盈会在搬运中把载荷楔出，纯摩擦路线已被 30+ 条量化否证穷尽；搬运段改用声明化约束，与臂侧世界同款机制（见 docs/debug/2026-09-24-joint-model-dog-arm.md §11.23(29)）。"
        },
        "gripper_carry": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "hold",
                "trajectory"
              ]
            },
            "segment_targets": {
              "type": "object"
            },
            "note": {
              "type": "string"
            }
          },
          "description": "搬运段夹爪语义的声明与逐段实际下发值（`hold` = 保持夹紧力，指令零位移）。"
        },
        "gripper_open_positions": {
          "type": "object",
          "description": "实际下发的夹爪张开位形（模型内关节名 → 值）。",
          "additionalProperties": {
            "type": "number"
          }
        },
        "payload_body": {
          "type": "string",
          "minLength": 1
        },
        "payload_in_tray": {
          "const": true,
          "description": "载荷的**实测**位置落在接收体的承载面范围内（按声明半尺寸 + 容差判定）。为 false 时不得返回成功。"
        },
        "phase_trace": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "各相位与逐样本的实测追踪（指腹中点/载荷 6 维位姿/接触对/夹爪状态），用于失败取证。"
        },
        "place_alignment": {
          "type": "object",
          "required": [
            "center_distance_m",
            "offset_from_center_m"
          ],
          "properties": {
            "center_distance_m": {
              "type": "number",
              "minimum": 0,
              "description": "下行到位时指腹中心到接收面目标点（顶面中心 + 声明间隙）的距离。"
            },
            "clearance_m": {
              "type": "number",
              "minimum": 0,
              "description": "下行终点相对接收体顶面的法向间隙（声明值）。"
            },
            "offset_from_center_m": {
              "type": "number",
              "minimum": 0,
              "description": "放置后实测载荷中心相对接收体承载面中心的**水平偏移**（场景判据 `max_offset_from_tray_center_m` 的测量来源）。"
            }
          },
          "additionalProperties": false
        },
        "place_mode": {
          "enum": [
            "declared_offset"
          ],
          "description": "放置点推法：declared_offset = 接收体顶面中心 + 声明的法向间隙（本场景唯一的合法模式）。"
        },
        "place_target_body": {
          "type": "string",
          "minLength": 1
        },
        "released": {
          "const": true,
          "description": "夹爪已张开到声明的开度（末态指腹开度实测）。"
        },
        "retreat_delta_m": {
          "type": "number",
          "minimum": 0,
          "description": "松开后抬离的高度（用于证明\"真的退开了\"，而不是停在接触面上）。"
        },
        "runtime_source": {
          "type": "string",
          "enum": [
            "live_fk"
          ],
          "description": "运行期数值来源：证据里的位姿一律取自**实测 FK**，不用构建期名义值。"
        },
        "segment_samples": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "运动过程中的采样行（与 phase_trace 同结构的运动期子集）。"
        },
        "place_settle_ms": {
          "type": "integer",
          "minimum": 1,
          "description": "放下后**落稳窗**的声明时长（毫秒，来自 piper_simulation_baseline.yaml: grasp.place_settle_ms）。载荷离手时是自由体、尚未落到承载面上 ⇒ 判“已放下”前必须先落稳（§11.23(47)）。"
        },
        "place_settled_gap_m": {
          "type": "number",
          "description": "落稳窗结束时实测的落位间隙（带符号；≤0 = 已接触/压入）：载荷最低点 − 承载面顶面。"
        },
        "place_settled_speed_mps": {
          "type": "number",
          "minimum": 0,
          "description": "落稳窗结束时实测的整链末速（模型内所有自由关节线速度上界）。"
        },
        "place_settled_on_target": {
          "type": "boolean",
          "description": "落稳窗结束时按**共享测量**（与四足侧同一函数）判定的“载荷落在承载面上”（存在接触 且 最低点不高于承载面 + 模型 margin）。"
        },
        "place_settled_margin_m": {
          "type": "number",
          "minimum": 0,
          "description": "落稳窗结束时实测的接触 margin（从模型读）：判“落在承载面上”的口径之一。"
        },
        "place_pose_correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "applied"
          ],
          "description": "把放置点从**构建期名义停靠位姿**纠正到**运行期实测接收体位姿**的量（托盘随载体运动 ⇒ 停靠误差会直接变成放置偏移）。mode 与上限由 piper_simulation_baseline.yaml: grasp.place_pose_correction 声明；未实现的模式必须显式失败（不得静默按名义位姿照放）。",
          "properties": {
            "mode": {
              "enum": [
                "off",
                "measure_only",
                "lateral_only",
                "full_pose"
              ]
            },
            "applied": {
              "type": "boolean",
              "description": "本轮是否真的施加了纠偏（measure_only/off ⇒ false）。"
            },
            "delta_world_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "实测接收体位姿 − 构建期名义位姿（世界系，米）。"
            },
            "lateral_m": {
              "type": "number",
              "minimum": 0,
              "description": "上述差值的水平模长（旋转不改变模长 ⇒ 与臂基座系同值）。"
            },
            "vertical_m": {
              "type": "number",
              "description": "竖直分量（世界 z）。"
            },
            "max_lateral_m": {
              "type": "number",
              "minimum": 0,
              "description": "声明允许施加的水平纠偏上限；超过即显式拒绝（不静默截断）。"
            },
            "applied_delta_world_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "实际施加的纠偏向量（世界系；lateral_only 时竖直分量为 0）。"
            },
            "segments": {
              "type": "object",
              "additionalProperties": false,
              "description": "逐段（above/descend）的重解自证：残差、实际位移、同半球点积、迭代数。",
              "properties": {
                "above": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "residual_m",
                    "hemisphere_dot"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "residual_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "shift_m": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "shift_error_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "hemisphere_dot": {
                      "type": "number"
                    },
                    "iterations": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "descend": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "residual_m",
                    "hemisphere_dot"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "residual_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "shift_m": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "shift_error_m": {
                      "type": "number",
                      "minimum": 0
                    },
                    "hemisphere_dot": {
                      "type": "number"
                    },
                    "iterations": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "ik_iterations": {
              "type": "integer",
              "minimum": 1,
              "description": "重解用的迭代上限（来自声明）。"
            },
            "ik_step": {
              "type": "number",
              "minimum": 0,
              "description": "重解用的步长（来自声明）。"
            },
            "max_residual_m": {
              "type": "number",
              "minimum": 0,
              "description": "重解残差与\"实际位移−请求位移\"的共同上限（来自声明）。"
            },
            "nominal_top_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "构建期名义承载面中心（世界系）= nominal_pose_m + R_nominal·[0,0,half_z]。"
            },
            "live_top_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "运行期实测承载面中心（世界系）= 实测 body 位姿 + R_live·[0,0,half_z]。"
            },
            "nominal_solution_pad_mid_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "构建期放置解（descend）下的指腹中点（世界系，实测 FK）。"
            },
            "nominal_solution_payload_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "同一状态下载荷中心（世界系）—— 即\"构建期解会把载荷送到哪\"。"
            },
            "nominal_solution_offset_m": {
              "type": "number",
              "minimum": 0,
              "description": "构建期解离\"名义承载面中心 + pad_offset\"的距离（≠0 ⇒ 构建基准与接收体中心本来就不重合）。"
            },
            "nominal_solution_lateral_m": {
              "type": "number",
              "minimum": 0,
              "description": "同上，只取水平分量。"
            },
            "carry_payload_offset_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              },
              "description": "测量时刻的**载荷中心 − 指腹中点**（世界系）：搬运过程产生的载荷相对夹口偏移，是放置偏移的主项。"
            },
            "carry_payload_lateral_m": {
              "type": "number",
              "minimum": 0,
              "description": "同上，只取水平模长（本轮实测 0.0548 m ⇒ 放置偏移的绝大部分）。"
            }
          }
        }
      }
    }
  }
}
