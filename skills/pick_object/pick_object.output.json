{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skill", "accepted", "target_id", "confirmation"],
  "additionalProperties": false,
  "properties": {
    "skill": {"const": "pick_object"},
    "accepted": {"const": true},
    "target_id": {"type": "string", "minLength": 1},
    "confirmation": {"enum": ["contact", "constraint", "gripper_state"]},
    "evidence": {
      "type": "object",
      "required": [
        "target_body",
        "left_finger_body",
        "right_finger_body",
        "bilateral_contact"
      ],
      "additionalProperties": false,
      "properties": {
        "target_body": {"type": "string", "minLength": 1},
        "left_finger_body": {"type": "string", "minLength": 1},
        "right_finger_body": {"type": "string", "minLength": 1},
        "bilateral_contact": {"const": true},
        "lifted": {"const": true},
        "constraint_activated": {"type": "boolean"},
        "lift_delta_m": {"type": "number", "minimum": 0}
      }
    }
  }
}
