{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "skill",
    "accepted",
    "target_id",
    "confirmation"
  ],
  "additionalProperties": false,
  "properties": {
    "skill": {
      "const": "pick_object"
    },
    "accepted": {
      "const": true
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "confirmation": {
      "enum": [
        "contact",
        "constraint",
        "gripper_state"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "target_body",
        "left_finger_body",
        "right_finger_body",
        "bilateral_contact"
      ],
      "additionalProperties": false,
      "properties": {
        "target_body": {
          "type": "string",
          "minLength": 1
        },
        "left_finger_body": {
          "type": "string",
          "minLength": 1
        },
        "right_finger_body": {
          "type": "string",
          "minLength": 1
        },
        "bilateral_contact": {
          "const": true
        },
        "lifted": {
          "const": true
        },
        "constraint_activated": {
          "type": "boolean"
        },
        "lift_peak_step": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "峰值抬升发生时的抬升段步序号（NULL = 未采到）。与 `lift_peak_delta_m` 配对，用于把'抬起后滑出'定位到具体时刻（§11.23(25)(26)）。"
        },
        "lift_peak_delta_m": {
          "type": "number",
          "minimum": 0,
          "description": "抬升段**过程中**载荷相对抬升前高度的**峰值**增量（m）。判据仍用结束时刻的 `lift_delta_m`（'结束时载荷是否还在夹口里'）；本项是**诊断量**：只取结束值会把'夹住→抬起→中途滑出'与'从未夹住'在报告里表达成同一个数（实测两者都≈0）。见 docs/debug/2026-09-24-joint-model-dog-arm.md §11.23(25)。"
        },
        "lift_delta_m": {
          "type": "number",
          "minimum": 0
        },
        "left_normal_force_n": {
          "type": "number",
          "minimum": 0
        },
        "right_normal_force_n": {
          "type": "number",
          "minimum": 0
        },
        "force_imbalance_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        },
        "force_ok": {
          "const": true
        },
        "grasp_alignment": {
          "type": "object",
          "required": [
            "center_distance_m"
          ],
          "properties": {
            "center_distance_m": {
              "type": "number",
              "minimum": 0
            },
            "pad_offset_m": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "grasp_mode": {
          "enum": [
            "pose_adaptive",
            "fallback_vertical"
          ],
          "description": "未知姿态抓取模式：pose_adaptive 按目标顶面法向适应，fallback_vertical 回退竖直抓取"
        },
        "approach_axis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "实际使用的接近轴（世界系单位向量）"
        }
      }
    }
  }
}
